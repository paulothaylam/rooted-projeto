@startuml
title Rooted – Casos de uso: público e participante
left to right direction

actor "Visitante" as Visitante
actor "Participante" as Participante

Visitante <|-- Participante

rectangle "Rooted" {
  usecase "Ver vitrine de eventos\n(busca e filtros)" as UC01
  usecase "Ver detalhes do evento" as UC02
  usecase "Criar conta\n(nome, e-mail, CPF, telefone, senha)" as UC03
  usecase "Entrar com e-mail e senha" as UC04
  usecase "Ver painel do participante" as UC05
  usecase "Inscrever-se em evento gratuito" as UC06
  usecase "Reservar vaga em evento pago\n(15 min, sem cobrança)" as UC07
  usecase "Editar perfil\n(nome, e-mail, CPF, telefone)" as UC08
  usecase "Cancelar inscrição\n(devolve vaga)" as UC09
  usecase "Excluir conta\n(sem inscrições ativas)" as UC10
  usecase "Sair (logout)" as UC11
}

Visitante -- UC01
Visitante -- UC02
Visitante -- UC03
Visitante -- UC04

Participante -- UC05
Participante -- UC06
Participante -- UC07
Participante -- UC08
Participante -- UC09
Participante -- UC10
Participante -- UC11

UC03 ..> UC04 : <<include>>
UC06 ..> UC02 : <<include>>
UC07 ..> UC02 : <<include>>

note right of UC07
  Evento pago: cria reserva com
  vence_em = now() + 15 min.
  Não há processamento de pagamento.
  Não há rotina de expiração automática.
end note

note right of UC09
  Cancelamento muda situação
  de ATIVA para CANCELADA
  e incrementa vagas do tipo_ingresso.
end note

note right of UC10
  Só permitido se COUNT(inscricoes) = 0.
  Remove reservas e perfil.
end note

@enduml